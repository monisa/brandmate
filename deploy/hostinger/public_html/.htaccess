# BrandMate on shared hosting: one domain serves both parts.
#   /api/...  and /up   -> Laravel (index.php)
#   real files          -> served as they are (JavaScript, CSS, images)
#   everything else     -> the Angular app (index.html), which handles its own pages

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send every visitor to https.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # PHP does not see the Authorization header unless it is passed on.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The API and the health check.
    RewriteRule ^(api|up)(/.*)?$ index.php [L]

    # Files that exist.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Any other address is a page inside the Angular app.
    RewriteRule ^ index.html [L]
</IfModule>

# Files with a unique name per release can be kept for a year. index.html and the
# app-installation files (service worker, its file list, manifest) must always be
# revalidated so a new release is picked up. Listed last, so they override the rule above.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(index\.html|ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
