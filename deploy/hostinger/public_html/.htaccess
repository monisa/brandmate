# BrandMate on shared hosting: one domain serves both parts.
#   /api/...  and /up   -> Laravel (index.php)
#   real files          -> served as they are (JavaScript, CSS, images)
#   everything else     -> the Angular app (index.html), which handles its own pages

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send every visitor to https.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # PHP does not see the Authorization header unless it is passed on.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The API and the health check.
    RewriteRule ^(api|up)(/.*)?$ index.php [L]

    # Files that exist.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Any other address is a page inside the Angular app.
    RewriteRule ^ index.html [L]
</IfModule>

# Files with a unique name per release can be kept for a year. index.html and the
# app-installation files (service worker, its file list, manifest) must always be
# revalidated so a new release is picked up. Listed last, so they override the rule above.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(index\.html|ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Only this site's own scripts run (plus Razorpay's checkout). The one inline handler allowed by its hash
    # is the one Angular puts on the stylesheet link. If the Angular build changes it, recompute the hash:
    #   printf "this.media='all'" | openssl dgst -sha256 -binary | openssl base64
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; script-src-attr 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://*.razorpay.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.razorpay.com; frame-src https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'none'"
</IfModule>
